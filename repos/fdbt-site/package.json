{
    "name": "site",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "test": "jest",
        "tsc": "./node_modules/.bin/tsc && ./node_modules/.bin/tsc --project tsconfig.server.json",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage --watchAll",
        "test:ci": "CI=true jest --silent -w 1 --forceExit",
        "test:updateSnapshots": "jest --updateSnapshot",
        "dev": "export NODE_ENV='development' && tsx --tsconfig tsconfig.server.json server/index.ts",
        "build:next": "next build",
        "build:server": "tsc --project tsconfig.server.json",
        "build": "npm run build:next && npm run build:server",
        "start": "NODE_ENV=production PORT=80 node dist/server/index.js",
        "lint": "eslint . --ext .ts,.tsx",
        "lint:fix": "eslint --fix . --ext .ts,.tsx",
        "lint:cypress": "cd cypress_tests && npm run lint",
        "lint:cypress-fix": "cd cypress_tests && npm run lint:fix",
        "postshrinkwrap": "npm install --no-package-lock --no-audit --no-fund --no-progress --silent && npx prettier --write ./package-lock.json",
        "precommit": ". npm run lint && npm run lint:cypress && npm run tsc && CI=true jest --silent",
        "prepare": "cd ../.. && husky repos/fdbt-site/.husky"
    },
    "lint-staged": {
        "./**/*.{ts,tsx}": [
            "prettier --c './**/*.{ts,tsx}'"
        ],
        "./**/*.{ts,tsx},.eslintignore": [
            "npm run lint:fix"
        ],
        "./cypress_tests/**/*.{ts,tsx}": [
            "npm run lint:cypress"
        ]
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-cognito-identity-provider": "^3.1085.0",
        "@aws-sdk/client-lambda": "^3.1085.0",
        "@aws-sdk/client-s3": "^3.1085.0",
        "@aws-sdk/client-ses": "^3.1085.0",
        "@aws-sdk/client-ssm": "^3.1085.0",
        "@aws-sdk/s3-request-presigner": "^3.1085.0",
        "clamscan": "^2.4.0",
        "cookie": "^1.1.1",
        "cookie-parser": "^1.4.7",
        "csurf": "^1.11.0",
        "csv-parse": "^7.0.1",
        "dayjs": "^1.11.21",
        "express": "^4.22.2",
        "express-mysql-session": "^3.0.3",
        "express-rate-limit": "^8.5.2",
        "express-session": "^1.19.0",
        "express-winston": "^4.2.0",
        "focus-trap-react": "^12.0.3",
        "formidable": "^3.5.4",
        "govuk-frontend": "^5.14.0",
        "helmet": "^8.2.0",
        "jose": "^6.2.3",
        "js-cookie": "^3.0.8",
        "jsdom-global": "^3.0.2",
        "lodash": "^4.18.1",
        "mysql2": "^3.22.6",
        "next": "16.2.10",
        "nocache": "^4.0.0",
        "nodemailer": "^9.0.3",
        "papaparse": "^5.5.4",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "swr": "^2.4.2",
        "toposort": "^2.0.2",
        "uuid": "^14.0.1",
        "winston": "^3.19.0",
        "xlsx": "^0.18.5",
        "yup": "^1.7.1",
        "zxcvbn": "^4.4.2"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/clamscan": "~2.4.1",
        "@types/cookie-parser": "~1.4.10",
        "@types/csurf": "~1.11.5",
        "@types/eslint-plugin-jsx-a11y": "~6.10.1",
        "@types/express": "~5.0.6",
        "@types/express-mysql-session": "~3.0.8",
        "@types/express-session": "~1.19.0",
        "@types/formidable": "~3.5.1",
        "@types/govuk-frontend": "~5.11.0",
        "@types/identity-obj-proxy": "~3.0.2",
        "@types/jest": "^30.0.0",
        "@types/js-cookie": "^3.0.6",
        "@types/jsdom": "~28.0.3",
        "@types/jsdom-global": "~3.0.7",
        "@types/lodash": "~4.17.24",
        "@types/node": "^24.13.3",
        "@types/nodemailer": "~8.0.1",
        "@types/papaparse": "~5.5.2",
        "@types/react": "~19.2.17",
        "@types/react-dom": "~19.2.3",
        "@types/toposort": "~2.0.7",
        "@types/zxcvbn": "~4.4.5",
        "@typescript-eslint/eslint-plugin": "^8.63.0",
        "@typescript-eslint/parser": "^8.63.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest": "^29.15.4",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "husky": "^9.1.7",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "jsdom": "^29.1.1",
        "prettier": "3.9.4",
        "sass": "^1.101.0",
        "tsx": "^4.23.0",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.6": true,
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "sharp@0.34.5": true,
        "unrs-resolver@1.12.2": true
    }
}
