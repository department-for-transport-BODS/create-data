{
    "name": "cypress",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "openCypress": "cypress open --config watchForFileChanges=false",
        "runCypress": "cypress run -b $BROWSER",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint --fix . --ext .ts",
        "postshrinkwrap": "npm install --no-package-lock --no-audit --no-fund --no-progress --silent && npx prettier --write ./package-lock.json"
    },
    "devDependencies": {
        "@types/bluebird": "^3.5.42",
        "cypress": "15.18.1",
        "cypress-file-upload": "^5.0.8",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-cypress": "^6.4.2",
        "eslint-plugin-prettier": "^5.5.6",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "allowScripts": {
        "cypress@15.18.1": true
    }
}
