{
    "compilerOptions": {
        "outDir": "./dist/",
        "rootDir": ".",
        "noImplicitAny": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "target": "ES2020",
        "jsx": "react",
        "allowJs": true,
        "types": ["cypress", "cypress-file-upload", "node"],
        "lib": ["ES5", "ES6", "DOM"],
        "moduleResolution": "bundler"
    },
    "exclude": ["./node_modules/*", "./dist/*", "node_modules", "./node_modules/*", "../../node_modules/*"]
}
