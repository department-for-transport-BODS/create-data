                >
                  <input
                    class="govuk-input govuk-input--width-30 govuk-product-name-input__inner__input"
                    id="purchase-method-name"
                    maxlength="50"
                    name="name"
                    type="text"
                    value="test"
                  />
                </div>
              </div>
            </div>
            <input
              class="govuk-button"
              id="continue-button"
              type="submit"
              value="Update purchase method"
            />
          </form>
        </div>
        <div
