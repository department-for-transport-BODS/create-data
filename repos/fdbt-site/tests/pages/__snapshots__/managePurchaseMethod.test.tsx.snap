exports[`pages manage purchase method should render error state on purchase method form group when error 1`] = `
<DocumentFragment>
  <div
    class="govuk-phase-banner app-phase-banner app-width-container"
  >
    <p
      class="govuk-phase-banner__content"
    >
      <strong
        class="govuk-tag govuk-phase-banner__content__tag"
      >
        Beta
      </strong>
      <span
        class="govuk-phase-banner__text"
      >
        This is a new service. Help us improve it and 
        <a
          class="govuk-link"
          href="/feedback"
          id="feedback-link"
        >
          give your feedback (opens in new tab)
        </a>
        .
      </span>
    </p>
  </div>
  <div
    class="govuk-width-container"
  >
    <main
      class="govuk-main-wrapper"
      id="main-content"
    >
      <div
        aria-labelledby="error-summary-title"
        class="govuk-error-summary"
        data-module="govuk-error-summary"
        role="alert"
        tabindex="-1"
      >
        <h2
          class="govuk-error-summary__title"
          id="error-summary-title"
        >
          There is a problem
        </h2>
        <div
          class="govuk-error-summary__body"
        >
          <ul
            class="govuk-list govuk-error-summary__list"
          >
            <li>
              <a
                href="#purchase-method-name"
              >
                You must select at least one day.
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div
        class="govuk-grid-row"
      >
        <div
          class="govuk-grid-column-two-thirds"
        >
          <form
            action="/api/managePurchaseMethod?_csrf="
            method="post"
          >
            <h1
              class="govuk-heading-l"
            >
              Provide  purchase method details
            </h1>
            <span
              class="govuk-hint"
              id="purchase-method-option-hint"
            >
              Select at least one from each section below
            </span>
            <input
              name="id"
              type="hidden"
              value="0"
            />
            <input
              name="isCapped"
              type="hidden"
              value="false"
            />
            <div
              class="govuk-form-group "
            >
              <fieldset
                aria-describedby="sop-purchase-locations"
                class="govuk-fieldset"
              >
                <legend
                  class="govuk-fieldset__legend govuk-fieldset__legend--s"
                  id="sop-purchase-locations"
                >
                  Where can tickets be sold?
                </legend>
                <div
                  class=""
                >
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-0-on-board"
                      name="purchaseLocations"
                      type="checkbox"
                      value="onBoard"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-0-on-board"
                    >
                      On board
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-1-online"
                      name="purchaseLocations"
                      type="checkbox"
                      value="online"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-1-online"
                    >
                      Online
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-2-mobile-device"
                      name="purchaseLocations"
                      type="checkbox"
                      value="mobileDevice"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-2-mobile-device"
                    >
                      Mobile device
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-3-postal"
                      name="purchaseLocations"
                      type="checkbox"
                      value="postal"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-3-postal"
                    >
                      Postal
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-4-agency"
                      name="purchaseLocations"
                      type="checkbox"
                      value="agency"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-4-agency"
                    >
                      Travel Shop
                    </label>
                  </div>
                </div>
              </fieldset>
            </div>
            <div
              class="govuk-form-group "
            >
              <fieldset
                aria-describedby="sop-payment-methods"
                class="govuk-fieldset"
              >
                <legend
                  class="govuk-fieldset__legend govuk-fieldset__legend--s"
                  id="sop-payment-methods"
                >
                  How can tickets be paid for?
                </legend>
                <div
                  class=""
                >
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-0-cash"
                      name="paymentMethods"
                      type="checkbox"
                      value="cash"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-0-cash"
                    >
                      Cash
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-1-debit-card"
                      name="paymentMethods"
                      type="checkbox"
                      value="debitCard"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-1-debit-card"
                    >
                      Debit card
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-2-credit-card"
                      name="paymentMethods"
                      type="checkbox"
                      value="creditCard"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-2-credit-card"
                    >
                      Credit card
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-3-mobile-phone"
                      name="paymentMethods"
                      type="checkbox"
                      value="mobilePhone"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-3-mobile-phone"
                    >
                      Mobile phone
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-4-cheque"
                      name="paymentMethods"
                      type="checkbox"
                      value="cheque"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-4-cheque"
                    >
                      Cheque
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-5-direct-debit"
                      name="paymentMethods"
                      type="checkbox"
                      value="directDebit"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-5-direct-debit"
                    >
                      Direct debit
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-6-contactless-travel-card"
                      name="paymentMethods"
                      type="checkbox"
                      value="contactlessTravelCard"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-6-contactless-travel-card"
                    >
                      Contactless SmartCard (e.g Oyster)
                    </label>
                  </div>
                </div>
              </fieldset>
            </div>
            <div
              class="govuk-form-group "
            >
              <fieldset
                aria-describedby="sop-ticket-formats"
                class="govuk-fieldset"
              >
                <legend
                  class="govuk-fieldset__legend govuk-fieldset__legend--s"
                  id="sop-ticket-formats"
                >
                  What format do the tickets come in?
                </legend>
                <div
                  class=""
                >
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-0-paper-ticket"
                      name="ticketFormats"
                      type="checkbox"
                      value="paperTicket"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-0-paper-ticket"
                    >
                      Paper ticket
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-1-mobile-app"
                      name="ticketFormats"
                      type="checkbox"
                      value="mobileApp"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-1-mobile-app"
                    >
                      Mobile app
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-2-smart-card"
                      name="ticketFormats"
                      type="checkbox"
                      value="smartCard"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-2-smart-card"
                    >
                      Smart card
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-3-electronic-document"
                      name="ticketFormats"
                      type="checkbox"
                      value="electronic_document"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-3-electronic-document"
                    >
                      Digital
                    </label>
                  </div>
                </div>
              </fieldset>
            </div>
            <div
              class="govuk-form-group govuk-form-group--error"
            >
              <div
                class="govuk-form-group"
              >
                <label
                  for="purchase-method-name"
                >
                  <h1
                    class="govuk-fieldset__legend govuk-fieldset__legend--s"
                  >
                    Provide a name for your purchase method
                  </h1>
                </label>
                <p
                  class="govuk-hint"
                  id="group-name-hint"
                >
                  50 characters maximum
                </p>
                <div
                  class=""
                >
                  <span
                    class="govuk-error-message"
                    id="purchase-method-name-error"
                  >
                    <span
                      class="govuk-visually-hidden"
                    >
                      Error: 
                    </span>
                    You must select at least one day.
                  </span>
                  <input
                    aria-describedby="purchase-method-name-error"
                    class="govuk-input govuk-input--width-30 govuk-product-name-input__inner__input govuk-input--error"
                    id="purchase-method-name"
                    maxlength="50"
                    name="name"
                    type="text"
                    value="test"
                  />
                </div>
              </div>
            </div>
            <input
              class="govuk-button"
              id="continue-button"
              type="submit"
              value="Update purchase method"
            />
          </form>
        </div>
        <div
          class="govuk-grid-column-one-third"
        >
          <h1
            class="govuk-heading-s"
          >
            What is a purchase method?
          </h1>
          <p
            class="govuk-body"
          >
            To create NeTEx for your fares, you need to provide the following:
          </p>
          <ol
            class="govuk-body"
          >
            <li>
              Where a ticket can be bought
            </li>
            <li>
              What payment methods can be used to buy a ticket
            </li>
            <li>
              In what format a ticket will be used by passengers
            </li>
          </ol>
          <p
            class="govuk-body"
          >
            This combination of information is known as a 
            <b>
              purchase method
            </b>
            .
          </p>
        </div>
      </div>
    </main>
    <div>
      <h2
        class="govuk-heading-s"
      >
        Help and Support
      </h2>
      <p
        class="govuk-body"
      >
        If you are having problems, please contact the Create Fares Data Service via this link: 
        <a
          class="govuk-link govuk-!-font-size-19"
          href="/contact"
        >
          Contact us
        </a>
      </p>
    </div>
  </div>
  <footer
    class="govuk-footer"
    role="contentinfo"
  >
