exports[`pages manage purchase method should render correctly in edit mode for capped ticket 1`] = `
<DocumentFragment>
  <div
    class="govuk-phase-banner app-phase-banner app-width-container"
  >
    <p
      class="govuk-phase-banner__content"
    >
      <strong
        class="govuk-tag govuk-phase-banner__content__tag"
      >
        Beta
      </strong>
      <span
        class="govuk-phase-banner__text"
      >
        This is a new service. Help us improve it and 
        <a
          class="govuk-link"
          href="/feedback"
          id="feedback-link"
        >
          give your feedback (opens in new tab)
        </a>
        .
      </span>
    </p>
  </div>
  <div
    class="govuk-width-container"
  >
    <main
      class="govuk-main-wrapper"
      id="main-content"
    >
      <a
        class="govuk-back-link"
        href="/viewPurchaseMethods"
      >
        Back
      </a>
      <div
        aria-labelledby="govuk-notification-banner-title"
        class="govuk-notification-banner"
        data-module="govuk-notification-banner"
      >
        <div
          class="govuk-notification-banner__header"
        >
          <h2
            class="govuk-notification-banner__title"
            id="govuk-notification-banner-title"
          >
            Important
          </h2>
        </div>
        <div
          class="govuk-notification-banner__content"
        >
          <p
            class="govuk-notification-banner__heading"
          >
            Editing and saving new changes will be applied to all fares using this purchase method.
          </p>
        </div>
      </div>
       
      <div
        class="govuk-grid-row"
      >
        <div
          class="govuk-grid-column-two-thirds"
        >
          <form
            action="/api/managePurchaseMethod?_csrf="
            method="post"
          >
            <h1
              class="govuk-heading-l"
            >
              Provide  purchase method details
            </h1>
            <span
              class="govuk-hint"
              id="purchase-method-option-hint"
            >
              Select at least one from each section below
            </span>
            <input
              name="id"
              type="hidden"
              value="0"
            />
            <input
              name="isCapped"
              type="hidden"
              value="false"
            />
            <div
              class="govuk-form-group "
            >
              <fieldset
                aria-describedby="sop-purchase-locations"
                class="govuk-fieldset"
              >
                <legend
                  class="govuk-fieldset__legend govuk-fieldset__legend--s"
                  id="sop-purchase-locations"
                >
                  Where can tickets be sold?
                </legend>
                <div
                  class=""
                >
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-0-on-board"
                      name="purchaseLocations"
                      type="checkbox"
                      value="onBoard"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-0-on-board"
                    >
                      On board
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-1-online"
                      name="purchaseLocations"
                      type="checkbox"
                      value="online"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-1-online"
                    >
                      Online
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-2-mobile-device"
                      name="purchaseLocations"
                      type="checkbox"
                      value="mobileDevice"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-2-mobile-device"
                    >
                      Mobile device
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-3-postal"
                      name="purchaseLocations"
                      type="checkbox"
                      value="postal"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-3-postal"
                    >
                      Postal
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-4-agency"
                      name="purchaseLocations"
                      type="checkbox"
                      value="agency"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-4-agency"
                    >
                      Travel Shop
                    </label>
                  </div>
                </div>
              </fieldset>
            </div>
            <div
              class="govuk-form-group "
            >
              <fieldset
                aria-describedby="sop-payment-methods"
                class="govuk-fieldset"
              >
