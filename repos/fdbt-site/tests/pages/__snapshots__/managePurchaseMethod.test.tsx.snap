                      type="checkbox"
                      value="mobileApp"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-0-mobile-app"
                    >
                      Mobile app
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-1-smart-card"
                      name="ticketFormats"
                      type="checkbox"
                      value="smartCard"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-1-smart-card"
                    >
                      Smart card
                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-2-electronic-document"
                      name="ticketFormats"
                      type="checkbox"
                      value="electronic_document"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-2-electronic-document"
                    >
                      Digital
                    </label>
                  </div>
                </div>
              </fieldset>
            </div>
            <div
              class="govuk-form-group "
            >
              <div
                class="govuk-form-group"
              >
                <label
                  for="purchase-method-name"
                >
                  <h1
                    class="govuk-fieldset__legend govuk-fieldset__legend--s"
                  >
                    Provide a name for your purchase method
                  </h1>
                </label>
                <p
                  class="govuk-hint"
