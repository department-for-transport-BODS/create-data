                    </label>
                  </div>
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="checkbox-2-credit-card"
                      name="paymentMethods"
                      type="checkbox"
                      value="creditCard"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="checkbox-2-credit-card"
                    >
