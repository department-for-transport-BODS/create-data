                            class="govuk-input govuk-input--width-40 govuk-product-name-input__inner__input"
                            id="multiple-product-name-0"
                            maxlength="50"
                            name="multipleProductNameInput0"
                            type="text"
                            value=""
                          />
                        </div>
                      </div>
                    </div>
                    <div
