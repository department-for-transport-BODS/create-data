                          >
                            <div
                              class="global-settings-time-restriction-row"
                            >
                              <div
                                class="govuk-form-group"
                              >
                                <div>
                                  <label
                                    class="govuk-label"
                                    for="start-time-tuesday-0"
                                  >
                                    Start time 
                                    <span
                                      class="govuk-visually-hidden"
                                    >
                                      for tuesday
                                    </span>
                                  </label>
                                  <input
                                    class="govuk-input govuk-input--width-5 govuk-!-margin-right-4 false"
                                    id="start-time-tuesday-0"
                                    name="startTimetuesday"
                                    type="text"
                                    value=""
                                  />
                                </div>
                                <div>
                                  <label
                                    class="govuk-label"
                                    for="end-time-tuesday-0"
                                  >
                                    End time 
                                    <span
