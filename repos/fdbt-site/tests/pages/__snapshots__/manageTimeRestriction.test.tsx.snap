        <a
          class="govuk-link"
          href="/feedback"
          id="feedback-link"
        >
          give your feedback (opens in new tab)
        </a>
        .
      </span>
    </p>
  </div>
  <div
    class="govuk-width-container"
  >
    <main
      class="govuk-main-wrapper"
      id="main-content"
    >
      <div
        class="govuk-grid-row"
      >
        <div
          class="govuk-grid-column-two-thirds"
        >
          <form
            action="/api/manageTimeRestriction?_csrf="
            method="post"
          >
            <a
              class="govuk-back-link"
              href="viewTimeRestrictions"
            >
              Back
            </a>
            <div
              aria-labelledby="govuk-notification-banner-title"
              class="govuk-notification-banner"
              data-module="govuk-notification-banner"
            >
              <div
                class="govuk-notification-banner__header"
              >
                <h2
                  class="govuk-notification-banner__title"
                  id="govuk-notification-banner-title"
                >
                  Important
                </h2>
              </div>
              <div
                class="govuk-notification-banner__content"
              >
                <p
                  class="govuk-notification-banner__heading"
                >
                  Editing and saving new changes will be applied to all fares using this time restriction.
                </p>
              </div>
            </div>
            <h1
              class="govuk-heading-l"
              id="manage-time-restriction-page-heading"
            >
              Provide time restriction details
            </h1>
            <span
              class="govuk-hint"
              id="manage-time-restriction-hint"
            >
              Select the days of the week that the tickets are valid for. If applicable, enter the times at which your tickets start and end. If they are valid at all times, select the day and leave the time blank. You cannot enter an end time without a start time.
            </span>
            <div
              class="govuk-inset-text"
              id="manage-time-restriction-inset-hint"
            >
              Enter times in 24hr format. For example 0900 is 9am, 1730 is 5:30pm.
            </div>
            <div
              class="govuk-form-group"
            >
              <fieldset
                aria-describedby="time-restriction-heading"
                class="govuk-fieldset"
              >
                <legend
                  class="govuk-fieldset__legend govuk-fieldset__legend--m"
                >
                  <h1
                    class="govuk-fieldset__heading"
                    id="time-restriction-heading"
                  >
                    Select the days of the week that are applicable
                  </h1>
                </legend>
                <input
                  name="id"
                  type="hidden"
                  value="0"
                />
                <div
                  class=""
                >
                  <div
                    class="govuk-checkboxes"
                    data-module="govuk-checkboxes"
                  >
                    <div>
                      <div
                        class="govuk-checkboxes__item"
                      >
                        <input
                          checked=""
                          class="govuk-checkboxes__input"
                          data-aria-controls="conditional-input-0"
                          id="time-restriction-day-0"
                          name="timeRestrictionDays"
                          type="checkbox"
                          value="monday"
                        />
                        <label
                          class="govuk-label govuk-checkboxes__label"
                          for="time-restriction-day-0"
                        >
                          Monday
                        </label>
                      </div>
                      <div
                        class="govuk-checkboxes__conditional govuk-checkboxes__conditional--hidden"
                        id="conditional-input-0"
                      >
                        <div
                          class="flex-container time-restrictions-table"
                        >
                          <div
                            class="govuk-form-group false"
                          >
                            <div
                              class="global-settings-time-restriction-row"
                            >
                              <div
                                class="govuk-form-group"
                              >
                                <div>
                                  <label
                                    class="govuk-label"
                                    for="start-time-monday-0"
                                  >
                                    Start time 
                                    <span
                                      class="govuk-visually-hidden"
                                    >
                                      for monday
                                    </span>
                                  </label>
                                  <input
                                    class="govuk-input govuk-input--width-5 govuk-!-margin-right-4 false"
                                    id="start-time-monday-0"
                                    name="startTimemonday"
                                    type="text"
                                    value="2200"
                                  />
                                </div>
                                <div>
                                  <label
