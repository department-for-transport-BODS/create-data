                    <span
                      class="govuk-hint"
                      id="info-hint"
                    >
                      You have saved your fare day end time.
                    </span>
                    <button
                      class="govuk-button"
                      type="button"
                    >
                      Ok
                    </button>
                  </div>
                </div>
              </div>
            </form>
          </div>
