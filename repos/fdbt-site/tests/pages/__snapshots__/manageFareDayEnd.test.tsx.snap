                    class="govuk-input govuk-input--width-5 govuk-!-margin-right-4"
                    id="fare-day-end-input"
                    name="fareDayEnd"
                    type="text"
                    value="1254"
                  />
                </div>
              </div>
              <input
                class="govuk-button"
                type="submit"
                value="Save"
              />
              <div
