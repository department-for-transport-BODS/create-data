              </legend>
              <div
                class="govuk-form-group"
              >
                <label
                  class="govuk-hint"
                  for="ageRangeMin"
                  id="age-range-min"
                >
                  Minimum age (if applicable)
                </label>
                <div
                  class=""
                >
                  <input
                    class="govuk-input govuk-input--width-5"
                    id="ageRangeMin"
                    name="ageRangeMin"
                    type="text"
                    value="4"
